# DeepSeek — direct, first-party.
# Used by DeepSeek Harness (dsh) natively, and by anything OpenAI-compatible.

export DEEPSEEK_API_KEY="__SET_ME__"
export DEEPSEEK_BASE_URL="https://api.deepseek.com"

# OpenAI-compatible aliases, for harnesses that look for these names instead.
export OPENAI_API_KEY="$DEEPSEEK_API_KEY"
export OPENAI_BASE_URL="$DEEPSEEK_BASE_URL"

export AGENT_MODEL_FAST="deepseek-v4"
export AGENT_MODEL_PRIMARY="deepseek-v4-pro"
export AGENT_MODEL_DEEP="deepseek-v4-pro"
