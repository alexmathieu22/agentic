# OpenRouter — one key, many models. Useful for trying a model without a new account.
#
# Caveat worth knowing before you rely on it: OpenRouter exposes both an
# OpenAI-compatible and an Anthropic-compatible endpoint, but agentic harnesses
# that assume first-party behaviour have reported friction with tool use and
# longer agentic loops through it. Fine for chat and for model comparison;
# verify tool-calling works before trusting it for real agent work.

export OPENROUTER_API_KEY="__SET_ME__"

# OpenAI-protocol harnesses
export OPENAI_API_KEY="$OPENROUTER_API_KEY"
export OPENAI_BASE_URL="https://openrouter.ai/api/v1"

# Anthropic-protocol harnesses
export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
export ANTHROPIC_BASE_URL="https://openrouter.ai/api/v1"

# Fully-qualified model ids — OpenRouter requires the vendor prefix.
export AGENT_MODEL_FAST="deepseek/deepseek-v4"
export AGENT_MODEL_PRIMARY="deepseek/deepseek-v4-pro"
export AGENT_MODEL_DEEP="anthropic/claude-opus-5"
